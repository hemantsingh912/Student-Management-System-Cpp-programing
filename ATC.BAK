#include<iostream.h>
#include<conio.h>
#include<string.h>
#include<fstream.h>
#include<dos.h>
#include<stdio.h> // printf ke liye zaruri hai

class issue
{
     long int Rollno,TCno,tcno;
      char phone_no[100],Aadhaar[100];
      char name[100],Fname[100],mname[100],dob[100],address[100],email[100];
      char bg[100];
      char gender[100], category[100],section;
      int SRno,clas;
   public:
 void showTCRequest()
    {
        issue t;
        char line[500];
        int found = 0;
	 int marsr=0;
	ifstream fin("tcrequest.txt");
	if (!fin)
	{
	    cout << "File not found!";
	    getch();
	    return;
	}

	clrscr();
	cout << "-------------------------------------------------------------------------------\n";
	printf("| %-5s | %-6s | %-6s | %-3.3s | %-10.10s | %-10.10s | %-11s |\n",
	       "TCNO", "SRNO", "CLASS", "SEC", "NAME", "FATHER", "PHONE");
	cout << "-------------------------------------------------------------------------------\n";

	while (fin.getline(line, 500))
	{
	    sscanf(line, "%ld|%d|%d|%c|%[^|]|%[^|]|%[^|]",
		   &t.tcno,
		   &t.SRno,
		   &t.clas,
		   &t.section,
		   t.name,
		   t.Fname,
		   t.phone_no);

	    found = 1;
	    marsr=t.SRno;

	    printf("| %-5ld | %-6d | %-6d | %-3.3c | %-10.10s | %-10.10s | %-11ld |\n",
		      t.tcno, t.SRno, t.clas, t.section, t.name, t.Fname, t.phone_no);
	}

	cout << "-------------------------------------------------------------------------------\n";

	if (!found)
	{
	    cout << "No Record Found";
	    getch();
	    fin.close();
	    return;
	}

	fin.close();

	char l[10];
	cout << "\nNOTE:- Tum isko TC dena chahte ho kya? YES/NO : ";
	cin >> l;

	if (strcmp(l, "YES") == 0 || strcmp(l, "yes") == 0)
	{
	    long int tc_input;
	    int sr_input;
	    cout << "Enter TC Number: ";
	    cin >> tc_input;


	    addview(tc_input);
	    delete_requestData(tc_input);
	    Delete_Marksheet(marsr);
	}

	getch();
    }

void addview(long int tcno_arg)
{
    issue s;
    char line[500];
    int found = 0;

    ifstream fin("tcrequest.txt");
    ofstream fout("tcview.txt", ios::app);

    if(!fin || !fout)
    {
        cout<<"File Error!";
        getch();
        return;
    }

    while(fin.getline(line,500))
    {
        sscanf(line,
        "%ld|%d|%d|%c|%ld|%[^|]|%[^|]|%[^|]|%[^|]|%[^|]|%[^|]|%[^|]|%[^|]|%[^|]|%[^|]|%[^|]",
        &s.tcno,
        &s.SRno,
        &s.clas,
        &s.section,
        &s.Rollno,
        s.name,
        s.Fname,
        s.mname,
        s.dob,
        s.phone_no,
        s.Aadhaar,
        s.gender,
        s.category,
        s.email,
        s.address,
        s.bg
        );

        if(s.tcno == tcno_arg)
        {
            fout << line << endl;   // ✔ same complete line
            found = 1;
            break;
        }
    }

    fin.close();
    fout.close();

    if(found)
        cout<<"\nTC View data saved successfully!";
    else
        cout<<"\nTCNO Not Found!";
}

    void delete_requestData(long int tcno_arg)
    {
	issue s;
	char line[500];
	int found = 0;

	ifstream fin("tcrequest.txt");
	ofstream fout("temp.txt");

	if (!fin)
	{
	    cout << "tcRequest.txt not found!";
	    getch();
	    return;
	}

	while (fin.getline(line, 500))
	{
	    sscanf(line, "%ld|%d|%d|%c|%[^|]|%[^|]|%[^|]",
		   &s.tcno,
		   &s.SRno,
		   &s.clas,
		   &s.section,
		   s.name,
		   s.Fname,
		   s.phone_no);

	    if (s.tcno == tcno_arg)
		found = 1;
	    else
		fout << line << endl;
	}

	fin.close();
	fout.close();

	remove("tcrequest.txt");
	rename("temp.txt", "tcrequest.txt");

	if (found)
	    cout << "\nTC Request Deleted!";
	else
	    cout << "\nTCNO Not Found!";
    }
	
	
	void showTCview()
{
    issue t;
    char line[400];
    int found = 0;

    ifstream fin("tcview.txt");

    if(!fin)
    {
        cout<<"File not found!";
        getch();
        return;
    }

    clrscr();
    cout << "-------------------------------------------------------------------------------\n";
    printf("| %-5s | %-6s | %-6s | %-3s | %-15s | %-10s | %-11s |\n",
           "TCNO", "SRNO", "CLASS", "SEC", "NAME", "FATHER", "PHONE");
    cout << "-------------------------------------------------------------------------------\n";

   
    while(fin.getline(line, 400))
    {
        sscanf(line,
        "%ld|%d|%d|%c|%ld|%[^|]|%[^|]|%[^|]|%[^|]|%[^|]|%[^|]|%[^|]|%[^|]|%[^|]|%[^|]|%[^|]",
        &t.tcno,
        &t.SRno,
        &t.clas,
        &t.section,
        &t.Rollno,
        t.name,
        t.Fname,
        t.mname,
        t.dob,
        t.phone_no,
        t.Aadhaar,
        t.gender,
        t.category,
        t.email,
        t.address,
        t.bg
        );

        found = 1;

        printf("| %-5ld | %-6d | %-6d | %-3c | %-15.15s | %-10.10s | %-11.11s |\n",
               t.tcno, t.SRno, t.clas, t.section, t.name, t.Fname, t.phone_no);
    }

    cout << "-------------------------------------------------------------------------------\n";

    if(!found)
    {
        cout<<"No Record Found";
    }

    fin.close();
    getch();
}


void Delete_Marksheet(int x)
{
    ifstream fin("marksheet.txt");
    ofstream fout("temp.txt");

    int sr, file_sr;
    int found = 0;
    char line[300];

    clrscr();
    cout << "Enter SR No to Delete Marksheet: ";
     sr=x;

    while(fin.getline(line, 300))
    {
	sscanf(line, "%d|", &file_sr);

	if(file_sr != sr)
	{
	    fout << line << endl;
	}
	else
	{
	    found = 1;
	}
    }

    fin.close();
    fout.close();

    remove("marksheet.txt");
    rename("temp.txt", "marksheet.txt");

    if(found)
	cout << "\nMarksheet Deleted Successfully!";
    else
	cout << "\nMarksheet Not Found!";

    getch();
}



};
void AdminTc()
{
	issue k;
	  while(1){
	       int y;
		      clrscr();
	  cout<<"\t===============================================================\n";
	  cout<<"\t          TRANSFER CERTIFICATE MANAGEMENT (ADMIN)\n";
	  cout<<"\t===============================================================\n\n\n\n";
		     cout<<"\t\t1. Issue Student TC\n";
		     cout<<"\t\t2. View Issue TCs\n";
		     cout<<"\t\t3.Back\n";
		     cout<<"\t\tSelect an Action:- ";
		     cin>>y;
		     if(y==3)
			return;
		       switch(y)
		       {
			     case 1:
			     k.showTCRequest();
			     break;
			     case 2:
			     k.showTCview();
			     break;
			     default:
			     cout<<"INvalid Value";
			     break;
		       }
		       }
  getch();

}